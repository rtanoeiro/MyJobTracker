###### Dev Env Vars ######
## Environments for running Migrations with Goose (host-run, dev only)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="postgresql://jobtracker:jobtracker@localhost:5433/jobs?sslmode=disable"
GOOSE_MIGRATION_DIR="./internal/db/schema/"


## Single connection string per environment. Use the first one for dev, and the second one for prod.
## For dev the exposed port is 5433 to avoid conflict with internal DB on 5432

## Dev: air (Go on host) and host-run goose both reach Postgres via localhost.
# POSTGRES_DB_STRING="postgresql://jobtracker:jobtracker@postgresql-job-applications:5433/jobs?sslmode=disable"_YOUR_CONNECTION_STRING_HERE"
###### Dev Env Vars ######

## If you're just deploying in a production environment (your home server). Use only the env vars below.
POSTGRES_DB_STRING="postgresql://jobtracker:jobtracker@postgresql-job-applications:5432/jobs?sslmode=disable"_YOUR_CONNECTION_STRING_HERE"

## Docker Compose host ports (only dev publishes Postgres; prod does not expose it to the host)
ADMINER_PORT=9100
## App Variables
PORT=9000

## Docker Compose for PostgreSQL
LOCAL_DATA_DIR="PATH_TO_DOCKER_MOUNTED_VOLUME"
POSTGRES_DB="jobs"
POSTGRES_USER="jobtracker"
POSTGRES_PASSWORD="jobtracker"
